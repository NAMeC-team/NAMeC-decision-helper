<https://namec.local/ontologie> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  https://namec.local/ontologie#aPourCause
:aPourCause rdf:type owl:ObjectProperty ;
            owl:inverseOf :causeConcerne ;
            rdfs:domain :Symptôme ;
            rdfs:range :Cause .


###  https://namec.local/ontologie#aPourNature
:aPourNature rdf:type owl:ObjectProperty ;
             rdfs:domain :Composant ;
             rdfs:range :NatureComposant .


###  https://namec.local/ontologie#causeConcerne
:causeConcerne rdf:type owl:ObjectProperty ;
               rdfs:domain :Cause ;
               rdfs:range :Composant .


###  https://namec.local/ontologie#contrôle
:contrôle rdf:type owl:ObjectProperty ;
          owl:inverseOf :estContrôléPar ;
          rdf:type owl:AsymmetricProperty ,
                   owl:IrreflexiveProperty ;
          rdfs:domain :Contrôleur ;
          rdfs:range :Composant .


###  https://namec.local/ontologie#estConnectéÀ
:estConnectéÀ rdf:type owl:ObjectProperty ,
                       owl:SymmetricProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain :Composant ;
              rdfs:range :Composant .


###  https://namec.local/ontologie#estContrôléPar
:estContrôléPar rdf:type owl:ObjectProperty ,
                         owl:AsymmetricProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain :Composant ;
                rdfs:range :Contrôleur .


###  https://namec.local/ontologie#estRésoluePar
:estRésoluePar rdf:type owl:ObjectProperty ;
               owl:inverseOf :résoud ;
               rdf:type owl:AsymmetricProperty ;
               rdfs:domain :Cause ;
               rdfs:range :Action .


###  https://namec.local/ontologie#résoud
:résoud rdf:type owl:ObjectProperty ,
                 owl:AsymmetricProperty ;
        rdfs:domain :Action ;
        rdfs:range :Cause .


###  https://namec.local/ontologie#symptômeAffecte
:symptômeAffecte rdf:type owl:ObjectProperty ;
                 rdfs:domain :Symptôme ;
                 rdfs:range :Composant .


#################################################################
#    Classes
#################################################################

###  https://namec.local/ontologie#Action
:Action rdf:type owl:Class ;
        rdfs:subClassOf :ÉléméntDiagnostic .


###  https://namec.local/ontologie#Actuateur
:Actuateur rdf:type owl:Class ;
           rdfs:subClassOf :Composant .


###  https://namec.local/ontologie#Capteur
:Capteur rdf:type owl:Class ;
         rdfs:subClassOf :Composant .


###  https://namec.local/ontologie#Cause
:Cause rdf:type owl:Class ;
       rdfs:subClassOf :ÉléméntDiagnostic .


###  https://namec.local/ontologie#Composant
:Composant rdf:type owl:Class ;
           rdfs:subClassOf :ÉlémentPhysique .


###  https://namec.local/ontologie#Contrôleur
:Contrôleur rdf:type owl:Class ;
            rdfs:subClassOf :Composant .


###  https://namec.local/ontologie#Descripteur
:Descripteur rdf:type owl:Class .


###  https://namec.local/ontologie#NatureComposant
:NatureComposant rdf:type owl:Class ;
                 rdfs:subClassOf :Descripteur .


###  https://namec.local/ontologie#Symptôme
:Symptôme rdf:type owl:Class ;
          rdfs:subClassOf :ÉléméntDiagnostic .


###  https://namec.local/ontologie#ÉlémentPhysique
:ÉlémentPhysique rdf:type owl:Class .


###  https://namec.local/ontologie#ÉléméntDiagnostic
:ÉléméntDiagnostic rdf:type owl:Class .


